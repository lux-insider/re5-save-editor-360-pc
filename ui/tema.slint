// Cores e medidas do editor, no estilo do RE5 Save Editor de shinneider:
// cartão claro e translúcido sobre o wallpaper, detalhes em vermelho.
export global Tema {
    out property <color> texto: #000000de;
    out property <color> texto-2: #00000099;
    out property <color> desativado: #00000061;
    out property <color> borda: #0000003b;
    out property <color> linha: #0000001f;
    out property <color> cartao: #ffffffc4;
    out property <color> painel: #ffffffe6;
    out property <color> azul: #1976d2;
    out property <color> vermelho: #d32f2f;
    out property <color> vermelho-escuro: #b71c1c;
    out property <color> verde: #2e7d32;
    out property <color> laranja: #ed6c02;
    out property <color> selecao: #1976d21f;

    out property <length> raio: 10px;
    out property <length> raio-campo: 4px;
    out property <length> fonte: 14px;
    out property <length> fonte-pequena: 12px;
}
