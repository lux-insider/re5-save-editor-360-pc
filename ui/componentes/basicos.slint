// Componentes simples reaproveitados em todas as telas.
import { LineEdit } from "std-widgets.slint";
import { Tema } from "../tema.slint";

// Botão no estilo "outlined error" do Material; `cheio` é o botão principal.
export component Botao inherits Rectangle {
    in property <string> texto;
    in property <bool> cheio: false;
    in property <bool> ativo: true;
    in property <bool> pequeno: false;
    callback clicado();

    min-width: t.preferred-width + (root.pequeno ? 20px : 40px);
    height: root.pequeno ? 30px : 38px;
    border-radius: Tema.raio-campo;
    border-width: root.cheio ? 0 : 1px;
    border-color: !root.ativo ? Tema.linha : (toque.has-hover ? Tema.vermelho : #d32f2f80);
    background: root.cheio
        ? (root.ativo ? (toque.has-hover ? Tema.vermelho-escuro : Tema.vermelho) : #0000001f)
        : (toque.has-hover && root.ativo ? #d32f2f0a : transparent);

    t := Text {
        text: root.texto;
        font-size: root.pequeno ? 13px : 15px;
        font-weight: 500;
        letter-spacing: 0.4px;
        color: !root.ativo ? #00000042 : (root.cheio ? white : Tema.vermelho);
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    toque := TouchArea {
        enabled: root.ativo;
        mouse-cursor: root.ativo ? pointer : default;
        clicked => { root.clicado(); }
    }
}

// Rótulo pequeno em cima e a caixa de texto embaixo.
export component Campo inherits VerticalLayout {
    alignment: start;
    in property <string> rotulo;
    in-out property <string> texto;
    in property <bool> leitura: false;
    in property <bool> invalido: false;
    in property <string> ajuda;
    in property <bool> ajuda-ok: false;
    in property <string> dica;
    callback editado(string);

    spacing: 3px;
    Text {
        text: root.rotulo;
        font-size: Tema.fonte-pequena;
        color: root.invalido ? Tema.vermelho : Tema.texto-2;
    }
    LineEdit {
        height: 46px;
        text <=> root.texto;
        read-only: root.leitura;
        placeholder-text: root.dica;
        enabled: !root.leitura;
        edited(t) => { root.editado(t); }
    }
    if root.ajuda != "": Text {
        text: root.ajuda;
        font-size: 11px;
        color: root.invalido ? Tema.vermelho : (root.ajuda-ok ? Tema.verde : Tema.texto-2);
    }
}

// Divisor com título no meio, como o Divider do Material.
export component Divisor inherits HorizontalLayout {
    in property <string> titulo;
    spacing: 10px;
    alignment: stretch;
    Rectangle { height: 1px; y: parent.height / 2; background: Tema.linha; horizontal-stretch: 1; }
    Text { text: root.titulo; font-size: 15px; color: Tema.texto; vertical-alignment: center; horizontal-stretch: 0; }
    Rectangle { height: 1px; y: parent.height / 2; background: Tema.linha; horizontal-stretch: 1; }
}

// Barra de abas simples: o conteúdo de cada aba é escolhido por quem usa.
export component BarraAbas inherits Rectangle {
    in property <[string]> abas;
    in-out property <int> atual: 0;
    callback trocou(int);

    height: 44px;
    HorizontalLayout {
        alignment: start;
        spacing: 4px;
        for aba[i] in root.abas: Rectangle {
            width: rotulo.preferred-width + 36px;
            rotulo := Text {
                text: aba;
                font-size: 14px;
                font-weight: root.atual == i ? 600 : 500;
                letter-spacing: 0.4px;
                color: root.atual == i ? Tema.vermelho : Tema.texto-2;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            Rectangle {
                y: parent.height - 3px;
                height: 3px;
                background: root.atual == i ? Tema.vermelho : (toque.has-hover ? Tema.linha : transparent);
            }
            toque := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.atual = i; root.trocou(i); }
            }
        }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Tema.linha; }
}

// Etiqueta colorida (ok / problema).
export component Selo inherits Rectangle {
    in property <string> texto;
    in property <bool> bom: true;
    height: 24px;
    width: s.preferred-width + 18px;
    border-radius: 12px;
    background: root.bom ? #2e7d321f : #d32f2f1f;
    s := Text {
        text: root.texto;
        font-size: 12px;
        font-weight: 600;
        color: root.bom ? Tema.verde : Tema.vermelho;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
